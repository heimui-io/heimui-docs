{
  "name": "values-as-text",
  "why": "An object or a list bound into text rendered as `[object Object]` on the Studio canvas and as JSON on a service, and the Go engine wrote its keys in a different order from the others. A value that is not text is written as compact JSON with every object's keys sorted -- the one form every language produces identically -- without escaping HTML or non-ASCII characters.",
  "options": {
    "onUnresolved": "keep"
  },
  "screen": {
    "id": "values_as_text",
    "version": "1.0.0",
    "root": {
      "type": "container",
      "id": "root",
      "children": [
        {
          "type": "text",
          "id": "object",
          "text": "{{ store }}"
        },
        {
          "type": "text",
          "id": "list",
          "text": "Tags: {{ tags }}"
        },
        {
          "type": "text",
          "id": "nested",
          "text": "{{ store.hours }}"
        },
        {
          "type": "text",
          "id": "scalars",
          "text": "{{ store.open }} {{ store.rating }} [{{ store.closed }}]"
        }
      ]
    }
  },
  "data": {
    "store": {
      "name": "Tienda Bogotá",
      "note": "a < b & c",
      "open": true,
      "rating": 4.5,
      "hours": {
        "sat": [
          9,
          14
        ],
        "mon": {
          "to": 18,
          "from": 9
        }
      },
      "closed": null
    },
    "tags": [
      "vegan",
      3,
      false,
      null,
      {
        "b": 2,
        "a": 1
      }
    ]
  },
  "expected": {
    "id": "values_as_text",
    "version": "1.0.0",
    "root": {
      "type": "container",
      "id": "root",
      "children": [
        {
          "type": "text",
          "id": "object",
          "text": "{\"closed\":null,\"hours\":{\"mon\":{\"from\":9,\"to\":18},\"sat\":[9,14]},\"name\":\"Tienda Bogotá\",\"note\":\"a < b & c\",\"open\":true,\"rating\":4.5}"
        },
        {
          "type": "text",
          "id": "list",
          "text": "Tags: [\"vegan\",3,false,null,{\"a\":1,\"b\":2}]"
        },
        {
          "type": "text",
          "id": "nested",
          "text": "{\"mon\":{\"from\":9,\"to\":18},\"sat\":[9,14]}"
        },
        {
          "type": "text",
          "id": "scalars",
          "text": "true 4.5 []"
        }
      ]
    }
  },
  "expectedUnresolved": []
}
